# Server
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set to production to fail fast on insecure config
NODE_ENV=development
# Where SQLite DB + disk cache live. Override in Docker to a mounted volume.
# DATA_DIR=./data

# JWT
# REQUIRED in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Auth
# Set to false to disable new user registration
ALLOW_REGISTRATION=true
# Initial user seeded ONLY when no users exist. Password is auto-generated
# and printed to the console (or set DEFAULT_PASSWORD to override).
DEFAULT_USERNAME=Ark
# DEFAULT_PASSWORD=

# Reddit
# Redlib-style OAuth spoofing (Android installed_client). No credentials needed.
REDDIT_USER_AGENT=android:com.reddit.frontpage:1.0.0 (by /u/redlib)
