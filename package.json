{
  "name": "signal",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Reddit client monorepo",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w packages/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
